# Environment Configuration Template
# NOTE: Local application execution NEVER requires AWS credentials or external secrets.

# System Settings
APP_ENV=local
LOG_LEVEL=INFO
DEVICE=auto

# Optional AWS Cloud Deployment Settings
# (Only required if running remote S3 telemetry export or ECS containerized deployment)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_TELEMETRY_BUCKET=
